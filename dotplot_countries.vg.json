{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot plot: % of small, medium and large businesses using AI in each European country (Eurostat, 2025) and Australia (ABS, 2024-25), sorted by large businesses.",
  "width": "container",
  "height": {"step": 15},
  "data": {
    "url": "ai_international.csv",
    "format": {"type": "csv", "parse": {"small": "number", "medium": "number", "large": "number"}}
  },
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {"field": "large", "op": "max", "order": "descending"},
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 11,
        "labelPadding": 6,
        "labelFontWeight": {"condition": {"test": "datum.value == 'Australia' || datum.value == 'EU average'", "value": 700}, "value": 400},
        "labelColor": {"condition": {"test": "datum.value == 'Australia'", "value": "#4b2aa0"}, "value": "#4a4458"}
      }
    }
  },
  "layer": [
    {
      "transform": [{"filter": "datum.iso == 'AUS' || datum.iso == 'EU27'"}],
      "mark": {"type": "bar", "height": {"band": 1}},
      "encoding": {
        "x": {"datum": 90, "type": "quantitative"},
        "color": {"condition": {"test": "datum.iso == 'AUS'", "value": "#efe9fc"}, "value": "#f1f0f3"}
      }
    },
    {
      "transform": [{"filter": "isValid(datum.small) && isValid(datum.large)"}],
      "mark": {"type": "rule", "color": "#d6d0e2", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "small", "type": "quantitative"},
        "x2": {"field": "large"}
      }
    },
    {
      "transform": [
        {"fold": ["small", "medium", "large"], "as": ["band", "pct"]},
        {"filter": "isValid(datum.pct)"},
        {"calculate": "{'small': 'Small', 'medium': 'Medium', 'large': 'Large'}[datum.band]", "as": "band_label"}
      ],
      "mark": {"type": "circle", "size": 70, "opacity": 1},
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "scale": {"domain": [0, 90]},
          "title": "% of businesses using AI",
          "axis": {"orient": "top", "grid": true, "tickCount": 8}
        },
        "color": {
          "field": "band_label",
          "type": "nominal",
          "scale": {"domain": ["Small", "Medium", "Large"], "range": ["#cbbcf2", "#8f6be3", "#3d1f8f"]},
          "legend": {"title": "Business size", "orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "band_label", "title": "Business size"},
          {"field": "pct", "title": "% using AI", "format": ".1f"},
          {"field": "source", "title": "Source"}
        ]
      }
    }
  ]
}
