{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Marimekko (variable-width column) chart: each column is an industry, its width is the number of businesses and its purple height is the % using AI, so the purple area = number of businesses using AI, 2024-25 (ABS).",
  "width": "container",
  "height": 320,
  "data": {
    "url": "ict_by_industry.csv",
    "format": {
      "type": "csv",
      "parse": {
        "ai": "number",
        "businesses": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "businesses",
          "as": "x_end"
        }
      ],
      "sort": [
        {
          "field": "ai",
          "order": "descending"
        },
        {
          "field": "industry",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.x_end - datum.businesses",
      "as": "x_start"
    },
    {
      "calculate": "(datum.x_start + datum.x_end) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "datum.businesses * datum.ai / 100",
      "as": "users"
    },
    {
      "calculate": "format(datum.users, '.0f') + 'k'",
      "as": "users_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "x_start",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          996
        ],
        "nice": false
      },
      "title": "Number of businesses (thousands): the wider the column, the more businesses in that industry",
      "axis": {
        "grid": false,
        "values": [
          0,
          200,
          400,
          600,
          800,
          996
        ]
      }
    },
    "y": {
      "field": "ai",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          55
        ]
      },
      "title": "% of businesses using AI",
      "axis": {
        "values": [
          0,
          10,
          20,
          30,
          40,
          50
        ],
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "color": "#6a3fd6",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x2": {
          "field": "x_end"
        },
        "y2": {
          "datum": 0
        },
        "tooltip": [
          {
            "field": "industry_full",
            "title": "Industry"
          },
          {
            "field": "businesses",
            "title": "Businesses ('000)"
          },
          {
            "field": "ai",
            "title": "% using AI",
            "format": ".1f"
          },
          {
            "field": "users",
            "title": "Businesses using AI ('000)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 5,
            "y": 39.5,
            "y2": 52
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#4b2aa0",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.businesses >= 10 && datum.industry != 'Media & telecoms'"
        }
      ],
      "mark": {
        "type": "text",
        "angle": 270,
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11,
        "color": "#4a4458"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "industry"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.businesses >= 40 && datum.ai >= 5"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 5,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "users_label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 8,
            "y": 53,
            "note": "Media & telecoms: highest rate of AI use (38%), but only about 10,000 businesses"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "fontWeight": 600,
        "color": "#4b2aa0",
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 736,
            "y": 26,
            "note": "Biggest industry, but only 12,000 of 186,000 use AI"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "fontWeight": 600,
        "color": "#4b2aa0",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 116.5,
            "y": 17,
            "note": "almost 1 in 3 of all"
          },
          {
            "x": 116.5,
            "y": 13.5,
            "note": "businesses using AI"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    }
  ]
}
