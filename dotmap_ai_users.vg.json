{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot density map: each dot is 250 businesses using AI, 2024-25 (ABS). Dots are placed at random inside their state or territory, so they show how many, not exactly where.",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ebe8f1",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "dots_ai_businesses.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 16,
        "color": "#6a3fd6",
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "abbr",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 114.0,
            "lat": -11.6,
            "lines": [
              "Northern Territory: the highest AI rate (18%),",
              "but only about 7,000 businesses, so just 5 dots"
            ]
          },
          {
            "lon": 114.0,
            "lat": -37.0,
            "lines": [
              "NSW and Victoria hold 65% of all businesses using AI.",
              "Their AI rates are only around average, but they",
              "are home to 60% of Australia's businesses."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11.5,
        "fontStyle": "italic",
        "fontWeight": 600,
        "color": "#4b2aa0",
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lines"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.3,
            "lat": -41.3,
            "lines": [
              "Tasmania: 2nd-highest rate (17%),",
              "but fewer AI users than WA"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11.5,
        "fontStyle": "italic",
        "fontWeight": 600,
        "color": "#4b2aa0",
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lines"
        }
      }
    }
  ]
}